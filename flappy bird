<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Flappy Cosita</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #111;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            touch-action: none; /* Prevent pull-to-refresh on mobile */
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        #ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
        }
        h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            color: #4ade80;
        }
        p {
            font-size: 1.5rem;
            margin-bottom: 20px;
        }
        .btn {
            pointer-events: auto;
            padding: 15px 30px;
            font-size: 1.5rem;
            background-color: #4ade80;
            color: #111;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: transform 0.1s;
        }
        .btn:active {
            transform: scale(0.95);
        }
        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <canvas id="gameCanvas"></canvas>

    <div id="ui-layer">
        <div id="start-screen">
            <h1>FLAPPY COSITA</h1>
            <p>1. Play Flappy Bird.<br>2. Expect the unexpected.</p>
            <button class="btn" onclick="startGame()">Tap to Start</button>
        </div>
        
        <div id="game-over-screen" class="hidden">
            <h1 id="go-title">Game Over!</h1>
            <p id="go-score">Score: 0</p>
            <button class="btn" onclick="startGame()">Play Again</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        // Game Constants & Variables
        let GAME_WIDTH = window.innerWidth;
        let GAME_HEIGHT = window.innerHeight;
        let GROUND_Y = 4000; // The ground is far below the starting sky
        
        // States: TITLE, FLAPPY, TRANSITION, CATCHER, GAMEOVER
        let state = 'TITLE';
        let time = 0;
        let cameraY = 0;

        // Flappy variables
        let bird = { x: 100, y: GAME_HEIGHT/2, vy: 0, radius: 15, frozen: false };
        let pipes = [];
        let flappyScore = 0;
        const GRAVITY = 0.4;
        const JUMP = -8;
        const PIPE_SPEED = 3;
        const PIPE_WIDTH = 60;
        const PIPE_GAP = 180;
        const FLAPPY_WIN_SCORE = 3;

        // Transition variables
        let unusualPoop = { x: 0, y: 0, vy: 0, type: '🌮' }; // The unusual poop is a Taco!
        let particles = [];

        // Catcher variables
        let alien = { x: GAME_WIDTH / 2, y: GROUND_Y - 100, width: 40 };
        let items = []; // Tacos and Bombs
        let catcherScore = 0;
        let catcherLives = 3;
        let spawnTimer = 0;
        let catcherDifficulty = 1;

        // Handle Resizing
        window.addEventListener('resize', () => {
            GAME_WIDTH = window.innerWidth;
            GAME_HEIGHT = window.innerHeight;
            canvas.width = GAME_WIDTH;
            canvas.height = GAME_HEIGHT;
            if(state === 'CATCHER') cameraY = GROUND_Y - GAME_HEIGHT;
        });
        window.dispatchEvent(new Event('resize'));

        // Input Handling
        let isFlapping = false;
        let targetAlienX = GAME_WIDTH / 2;

        function handlePointerDown(e) {
            if (state === 'FLAPPY' && !bird.frozen) {
                bird.vy = JUMP;
            }
            updatePointer(e);
        }

        function handlePointerMove(e) {
            updatePointer(e);
        }

        function updatePointer(e) {
            if (state === 'CATCHER') {
                let clientX = e.touches ? e.touches[0].clientX : e.clientX;
                targetAlienX = clientX;
            }
        }

        window.addEventListener('mousedown', handlePointerDown);
        window.addEventListener('touchstart', handlePointerDown, {passive: false});
        window.addEventListener('mousemove', handlePointerMove);
        window.addEventListener('touchmove', handlePointerMove, {passive: false});

        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && state === 'FLAPPY' && !bird.frozen) {
                bird.vy = JUMP;
            }
        });

        // Initialize / Start Game
        function startGame() {
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('game-over-screen').classList.add('hidden');
            
            // Reset Flappy State
            bird = { x: GAME_WIDTH/3, y: GAME_HEIGHT/2, vy: 0, radius: 15, frozen: false };
            pipes = [];
            flappyScore = 0;
            cameraY = 0;
            particles = [];
            
            // Reset Catcher State
            items = [];
            catcherScore = 0;
            catcherLives = 3;
            catcherDifficulty = 1;
            targetAlienX = GAME_WIDTH / 2;
            alien.x = targetAlienX;

            state = 'FLAPPY';
            spawnPipe();
        }

        function gameOver(reason) {
            state = 'GAMEOVER';
            document.getElementById('game-over-screen').classList.remove('hidden');
            document.getElementById('go-title').innerText = reason;
            document.getElementById('go-score').innerText = `Tacos Caught: ${catcherScore}`;
        }

        // Logic Updates
        function update() {
            time++;

            if (state === 'FLAPPY') {
                if (!bird.frozen) {
                    bird.vy += GRAVITY;
                    bird.y += bird.vy;

                    // Pipe generation
                    if (pipes.length === 0 || pipes[pipes.length - 1].x < GAME_WIDTH - 250) {
                        spawnPipe();
                    }

                    // Pipe movement and collision
                    for (let i = pipes.length - 1; i >= 0; i--) {
                        let p = pipes[i];
                        p.x -= PIPE_SPEED;

                        // Check score
                        if (!p.passed && p.x + PIPE_WIDTH < bird.x) {
                            p.passed = true;
                            flappyScore++;
                            if (flappyScore >= FLAPPY_WIN_SCORE) {
                                // Trigger Transition!
                                triggerTransition();
                            }
                        }

                        // Check collision
                        if (bird.x + bird.radius > p.x && bird.x - bird.radius < p.x + PIPE_WIDTH) {
                            if (bird.y - bird.radius < p.topHeight || bird.y + bird.radius > p.topHeight + PIPE_GAP) {
                                startGame(); // Restart flappy if hit
                            }
                        }

                        // Remove offscreen pipes
                        if (p.x + PIPE_WIDTH < 0) {
                            pipes.splice(i, 1);
                        }
                    }

                    // Floor/Ceiling collision
                    if (bird.y + bird.radius > GAME_HEIGHT || bird.y - bird.radius < 0) {
                        startGame();
                    }
                }
            } 
            else if (state === 'TRANSITION') {
                // Taco falls
                unusualPoop.vy += 0.2; // Taco gravity
                unusualPoop.y += unusualPoop.vy;
                
                // Add magical trail particles
                if (time % 2 === 0) {
                    particles.push({
                        x: unusualPoop.x + (Math.random() - 0.5) * 20,
                        y: unusualPoop.y,
                        vx: (Math.random() - 0.5) * 2,
                        vy: (Math.random() - 0.5) * 2,
                        life: 30,
                        maxLife: 30
                    });
                }

                // Camera follows the taco downwards
                let targetCameraY = unusualPoop.y - GAME_HEIGHT / 2;
                if (targetCameraY > GROUND_Y - GAME_HEIGHT) {
                    targetCameraY = GROUND_Y - GAME_HEIGHT; // Stop at ground
                }
                cameraY += (targetCameraY - cameraY) * 0.1; // Smooth follow

                // Transition to catcher when taco hits the ground viewport
                if (unusualPoop.y > GROUND_Y - 50) {
                    state = 'CATCHER';
                    createExplosion(unusualPoop.x, GROUND_Y - 50, '#FFD700');
                }
            } 
            else if (state === 'CATCHER') {
                cameraY = GROUND_Y - GAME_HEIGHT; // Lock camera to ground
                
                // Move alien smoothly
                alien.x += (targetAlienX - alien.x) * 0.2;
                // Clamp alien to screen
                if (alien.x < 30) alien.x = 30;
                if (alien.x > GAME_WIDTH - 30) alien.x = GAME_WIDTH - 30;

                // Spawn items
                spawnTimer++;
                if (spawnTimer > 60 / catcherDifficulty) {
                    spawnTimer = 0;
                    items.push({
                        x: Math.random() * (GAME_WIDTH - 40) + 20,
                        y: cameraY - 50,
                        vy: (Math.random() * 3 + 4) * catcherDifficulty,
                        type: Math.random() > 0.8 ? '💣' : '🌮', // 20% bomb, 80% taco
                        rotation: Math.random() * Math.PI * 2,
                        rotSpeed: (Math.random() - 0.5) * 0.2
                    });
                    catcherDifficulty += 0.02; // Slowly increase difficulty
                }

                // Update items
                for (let i = items.length - 1; i >= 0; i--) {
                    let item = items[i];
                    item.y += item.vy;
                    item.rotation += item.rotSpeed;

                    // Collision with ground
                    if (item.y > GROUND_Y - 20) {
                        if (item.type === '🌮') {
                            catcherLives--;
                            createExplosion(item.x, item.y, '#ff4444');
                            if (catcherLives <= 0) gameOver("You dropped too many!");
                        }
                        items.splice(i, 1);
                        continue;
                    }

                    // Collision with alien (Bucket zone is around alien.y - 60)
                    let dx = item.x - alien.x;
                    let dy = item.y - (alien.y - 60);
                    let dist = Math.sqrt(dx*dx + dy*dy);

                    if (dist < 40) {
                        if (item.type === '💣') {
                            createExplosion(item.x, item.y, '#FF0000');
                            gameOver("You caught a bomb!");
                        } else {
                            catcherScore++;
                            createExplosion(item.x, item.y, '#FFD700'); // Gold sparkle
                        }
                        items.splice(i, 1);
                    }
                }
            }

            // Update particles
            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life--;
                if (p.life <= 0) particles.splice(i, 1);
            }
        }

        // Draw Game
        function draw() {
            // Background gradient based on Camera Y (Sky to Space to Ground)
            let depthFactor = cameraY / (GROUND_Y - GAME_HEIGHT);
            if (depthFactor < 0) depthFactor = 0;
            if (depthFactor > 1) depthFactor = 1;

            let topColor = interpolateColor('#87CEEB', '#0a0a2a', depthFactor);
            let bottomColor = interpolateColor('#E0F6FF', '#1a0a1a', depthFactor);

            let bgGradient = ctx.createLinearGradient(0, 0, 0, GAME_HEIGHT);
            bgGradient.addColorStop(0, topColor);
            bgGradient.addColorStop(1, bottomColor);
            ctx.fillStyle = bgGradient;
            ctx.fillRect(0, 0, GAME_WIDTH, GAME_HEIGHT);

            ctx.save();
            ctx.translate(0, -cameraY); // Apply Camera

            // Draw Stars in the background during transition
            if (cameraY > GAME_HEIGHT) {
                ctx.fillStyle = 'white';
                for(let i=0; i<50; i++) {
                    // Stable random based on index
                    let sx = (Math.sin(i*123) * 0.5 + 0.5) * GAME_WIDTH;
                    let sy = (Math.cos(i*321) * 0.5 + 0.5) * GROUND_Y;
                    if(sy > cameraY && sy < cameraY + GAME_HEIGHT) {
                        ctx.globalAlpha = Math.abs(Math.sin(time*0.05 + i));
                        ctx.beginPath(); ctx.arc(sx, sy, 2, 0, Math.PI*2); ctx.fill();
                    }
                }
                ctx.globalAlpha = 1;
            }

            // Draw Ground
            ctx.fillStyle = '#2d1b10'; // Dark dirt
            ctx.fillRect(0, GROUND_Y, GAME_WIDTH, 500);
            ctx.fillStyle = '#1c5e20'; // Dark grass
            ctx.fillRect(0, GROUND_Y, GAME_WIDTH, 20);

            if (state === 'FLAPPY' || state === 'TRANSITION') {
                // Draw Pipes
                ctx.fillStyle = '#2ecc71';
                pipes.forEach(p => {
                    ctx.fillRect(p.x, 0, PIPE_WIDTH, p.topHeight);
                    ctx.fillRect(p.x, p.topHeight + PIPE_GAP, PIPE_WIDTH, GROUND_Y);
                    
                    // Pipe borders
                    ctx.strokeStyle = '#27ae60';
                    ctx.lineWidth = 4;
                    ctx.strokeRect(p.x, 0, PIPE_WIDTH, p.topHeight);
                    ctx.strokeRect(p.x, p.topHeight + PIPE_GAP, PIPE_WIDTH, GROUND_Y);
                });

                // Draw Bird
                ctx.save();
                ctx.translate(bird.x, bird.y);
                if (!bird.frozen) {
                    ctx.rotate(Math.min(Math.PI / 4, Math.max(-Math.PI / 4, (bird.vy * 0.1))));
                } else {
                    // Shaking effect when frozen
                    ctx.translate((Math.random()-0.5)*5, (Math.random()-0.5)*5);
                }
                ctx.font = "30px Arial";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText("🐦", 0, 0);
                
                if (bird.frozen && state === 'TRANSITION' && unusualPoop.y < bird.y + 10) {
                    // Exclamation mark before dropping
                    ctx.fillStyle = 'red';
                    ctx.font = "bold 24px Arial";
                    ctx.fillText("❗", 0, -30);
                }
                ctx.restore();
            }

            if (state === 'TRANSITION' || state === 'CATCHER') {
                // Draw falling unusual poop (Taco)
                if (state === 'TRANSITION') {
                    ctx.save();
                    ctx.translate(unusualPoop.x, unusualPoop.y);
                    ctx.rotate(time * 0.1);
                    ctx.font = "40px Arial";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    // Glow effect
                    ctx.shadowBlur = 20;
                    ctx.shadowColor = "yellow";
                    ctx.fillText(unusualPoop.type, 0, 0);
                    ctx.restore();
                }

                // Draw Catcher Alien (Dame Tu Cosita)
                if (cameraY >= GROUND_Y - GAME_HEIGHT - 200) {
                    drawAlien(alien.x, alien.y, time);
                }

                // Draw Items
                items.forEach(item => {
                    ctx.save();
                    ctx.translate(item.x, item.y);
                    ctx.rotate(item.rotation);
                    ctx.font = "35px Arial";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    if (item.type === '🌮') {
                        ctx.shadowBlur = 10;
                        ctx.shadowColor = "gold";
                    }
                    ctx.fillText(item.type, 0, 0);
                    ctx.restore();
                });
            }

            // Draw Particles
            particles.forEach(p => {
                ctx.fillStyle = `rgba(255, 215, 0, ${p.life / p.maxLife})`;
                ctx.beginPath();
                ctx.arc(p.x, p.y, 3, 0, Math.PI*2);
                ctx.fill();
            });

            ctx.restore(); // Restore Camera

            // Draw UI Overlays (Fixed to screen)
            if (state === 'FLAPPY') {
                ctx.fillStyle = 'white';
                ctx.font = 'bold 40px Arial';
                ctx.textAlign = 'center';
                ctx.fillText(flappyScore, GAME_WIDTH/2, 100);
            } 
            else if (state === 'CATCHER') {
                ctx.fillStyle = 'white';
                ctx.font = 'bold 24px Arial';
                ctx.textAlign = 'left';
                ctx.fillText(`Tacos: ${catcherScore}`, 20, 40);
                
                ctx.textAlign = 'right';
                let livesStr = "";
                for(let i=0; i<catcherLives; i++) livesStr += "❤️";
                ctx.fillText(livesStr, GAME_WIDTH - 20, 40);
            }
            else if (state === 'TRANSITION') {
                ctx.fillStyle = 'white';
                ctx.font = 'bold 30px Arial';
                ctx.textAlign = 'center';
                ctx.shadowBlur = 5;
                ctx.shadowColor = "black";
                ctx.fillText("Uh oh... what did he eat?!", GAME_WIDTH/2, 150);
                ctx.shadowBlur = 0;
            }

            requestAnimationFrame(draw);
            update();
        }

        // Helper Functions
        function spawnPipe() {
            let minHeight = 50;
            let maxHeight = GAME_HEIGHT - PIPE_GAP - minHeight;
            let topHeight = Math.floor(Math.random() * (maxHeight - minHeight + 1) + minHeight);
            
            pipes.push({
                x: GAME_WIDTH,
                topHeight: topHeight,
                passed: false
            });
        }

        function triggerTransition() {
            state = 'TRANSITION';
            bird.frozen = true;
            unusualPoop.x = bird.x;
            unusualPoop.y = bird.y;
            unusualPoop.vy = -5; // Little pop up before falling
        }

        function drawAlien(x, y, t) {
            ctx.save();
            ctx.translate(x, y);
            
            // "Dame Tu Cosita" dancing math
            let sway = Math.sin(t * 0.1) * 15; // Fast hip sway
            let bounce = Math.abs(Math.sin(t * 0.15)) * 10;
            
            // Bucket
            ctx.font = "40px Arial";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText("🪣", sway * 0.5, -60 - bounce);

            ctx.fillStyle = '#4ade80'; // Bright Alien Green
            ctx.strokeStyle = '#4ade80';
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            // Left Leg
            ctx.lineWidth = 8;
            ctx.beginPath(); ctx.moveTo(-10 + sway*0.2, -30 - bounce); 
            ctx.lineTo(-20, -15 - bounce*0.5); ctx.lineTo(-10, 0); ctx.stroke();
            
            // Right Leg
            ctx.beginPath(); ctx.moveTo(10 + sway*0.2, -30 - bounce); 
            ctx.lineTo(20, -15 - bounce*0.5); ctx.lineTo(10, 0); ctx.stroke();

            // Body
            ctx.fillRect(-8 + sway*0.2, -80 - bounce, 16, 50);

            // Head (Emoji for perfection)
            ctx.font = "35px Arial";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.save();
            ctx.translate(sway*0.8, -95 - bounce);
            ctx.rotate(Math.sin(t*0.05)*0.2); // Head bob
            ctx.fillText("👽", 0, 0);
            ctx.restore();

            // Arms (Holding the bucket)
            let shoulderY = -70 - bounce;
            ctx.lineWidth = 6;
            // Left Arm
            ctx.beginPath(); ctx.moveTo(-8 + sway*0.2, shoulderY); 
            ctx.lineTo(-25, shoulderY + 10); ctx.lineTo(-15 + sway*0.5, -60 - bounce); ctx.stroke();
            // Right Arm
            ctx.beginPath(); ctx.moveTo(8 + sway*0.2, shoulderY); 
            ctx.lineTo(25, shoulderY + 10); ctx.lineTo(15 + sway*0.5, -60 - bounce); ctx.stroke();

            ctx.restore();
        }

        function createExplosion(x, y, color) {
            for (let i = 0; i < 20; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 10,
                    vy: (Math.random() - 0.5) * 10,
                    life: 20,
                    maxLife: 20
                });
            }
        }

        function interpolateColor(color1, color2, factor) {
            // Very basic hex to rgb interpolation
            let c1 = hexToRgb(color1);
            let c2 = hexToRgb(color2);
            let r = Math.round(c1.r + factor * (c2.r - c1.r));
            let g = Math.round(c1.g + factor * (c2.g - c1.g));
            let b = Math.round(c1.b + factor * (c2.b - c1.b));
            return `rgb(${r},${g},${b})`;
        }

        function hexToRgb(hex) {
            let result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
            return result ? {
                r: parseInt(result[1], 16),
                g: parseInt(result[2], 16),
                b: parseInt(result[3], 16)
            } : {r:0, g:0, b:0};
        }

        // Start the loop
        requestAnimationFrame(draw);

    </script>
</body>
</html>
